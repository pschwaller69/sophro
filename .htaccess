Options -Indexes
DirectoryIndex index.php
AddType application/manifest+json .webmanifest
AddDefaultCharset UTF-8

RewriteEngine On

# Toujours en HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Liens de partage : /p/12 -> index.php?p=12
RewriteRule ^p/([0-9]+)/?$ index.php?p=$1 [L,QSA]

# Fichiers privés
RewriteRule ^(lib|data|tools|\.github|\.git)(/|$) - [F,L]
<FilesMatch "^(config\.local\.php|\.user\.ini|README\.md|\.gitignore|.*\.sqlite.*)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType audio/mpeg "access plus 30 days"
</IfModule>
